<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <!--
    Parent: jpetstore-parent (multi-module reactor parent)
    The parent POM imports the Spring Boot 3.5.12 BOM, Spring Cloud BOM,
    Testcontainers BOM, and manages common dependency versions.
    All Spring Boot starter dependencies are BOM-managed — no version tags needed.
  -->
  <parent>
    <groupId>org.mybatis</groupId>
    <artifactId>jpetstore-parent</artifactId>
    <version>6.2.1-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <groupId>com.jpetstore</groupId>
  <artifactId>catalog-service</artifactId>
  <version>6.2.1-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>JPetStore Catalog Service</name>
  <description>Catalog/Inventory bounded context microservice for JPetStore — manages categories, products, items, inventory, and suppliers via REST APIs backed by Spring Data JPA and PostgreSQL</description>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>

    <!-- ==================== -->
    <!-- Spring Boot Starters -->
    <!-- ==================== -->

    <!-- REST API and embedded Tomcat -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Spring Data JPA + Hibernate (replaces MyBatis mappers from monolith) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- Jakarta Bean Validation for request/entity validation -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Health checks, metrics, and readiness probes -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Spring Security for defense-in-depth security headers on all responses.
         Configured to permit all requests (catalog is public/read-only) while
         adding standard security headers: X-Content-Type-Options, X-Frame-Options,
         X-XSS-Protection, Referrer-Policy, Cache-Control, Pragma, Expires. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!-- ============ -->
    <!-- JWT (JJWT)  -->
    <!-- ============ -->

    <!-- JJWT for defense-in-depth JWT token validation on protected endpoints
         (e.g., POST /api/items/{id}/inventory/decrement).
         The JJWT version is managed by the parent POM (jjwt.version=0.12.6). -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- ======== -->
    <!-- Database -->
    <!-- ======== -->

    <!-- PostgreSQL JDBC driver (per-service database, replacing monolith HSQLDB) -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Liquibase for database schema management via changelogs -->
    <dependency>
      <groupId>org.liquibase</groupId>
      <artifactId>liquibase-core</artifactId>
    </dependency>

    <!-- ======= -->
    <!-- Testing -->
    <!-- ======= -->

    <!-- JUnit 5, Mockito, AssertJ, Spring Test support -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Spring Security Test — provides @WithMockUser for authenticated endpoint tests
         (e.g., POST /api/items/{id}/inventory/decrement requires authentication per SecurityConfig) -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Testcontainers PostgreSQL for integration tests against real database -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Testcontainers JUnit 5 integration for lifecycle management -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <!-- Surefire — unit tests only; exclude *IT integration tests (run by failsafe) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/*IT.java</exclude>
          </excludes>
          <excludedGroups>integration</excludedGroups>
        </configuration>
      </plugin>
      <!-- Failsafe — integration tests (*IT.java) with @Tag("integration") during verify phase -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.5.5</version>
        <configuration>
          <includes>
            <include>**/*IT.java</include>
          </includes>
          <groups>integration</groups>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- JaCoCo — code coverage measurement with minimum 80% instruction coverage enforcement
           per AAP requirement: "New service code must achieve > 80% test coverage" -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>INSTRUCTION</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Spring Boot Maven Plugin — builds executable JAR with embedded Tomcat -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
            <configuration>
              <!-- Preserve the original thin JAR for failsafe classpath; fat JAR gets -exec suffix -->
              <classifier>exec</classifier>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
