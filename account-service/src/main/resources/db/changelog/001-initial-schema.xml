<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-initial-schema" author="jpetstore-migration">
        <comment>Create Account/User Management bounded context tables: signon, account, profile, bannerdata</comment>

        <!-- ============================================================ -->
        <!-- signon table                                                 -->
        <!-- Source: jpetstore-hsqldb-schema.sql lines 30-34              -->
        <!-- Stores user authentication credentials (username + password) -->
        <!-- ============================================================ -->
        <createTable tableName="signon">
            <column name="username" type="varchar(25)">
                <constraints primaryKey="true" primaryKeyName="pk_signon" nullable="false"/>
            </column>
            <column name="password" type="varchar(25)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- ============================================================ -->
        <!-- account table                                                -->
        <!-- Source: jpetstore-hsqldb-schema.sql lines 36-50              -->
        <!-- Stores user profile and address information                  -->
        <!-- ============================================================ -->
        <createTable tableName="account">
            <column name="userid" type="varchar(80)">
                <constraints primaryKey="true" primaryKeyName="pk_account" nullable="false"/>
            </column>
            <column name="email" type="varchar(80)">
                <constraints nullable="false"/>
            </column>
            <column name="firstname" type="varchar(80)">
                <constraints nullable="false"/>
            </column>
            <column name="lastname" type="varchar(80)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(2)"/>
            <column name="addr1" type="varchar(80)">
                <constraints nullable="false"/>
            </column>
            <column name="addr2" type="varchar(40)"/>
            <column name="city" type="varchar(80)">
                <constraints nullable="false"/>
            </column>
            <column name="state" type="varchar(80)">
                <constraints nullable="false"/>
            </column>
            <column name="zip" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="country" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="phone" type="varchar(80)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- ============================================================ -->
        <!-- profile table                                                -->
        <!-- Source: jpetstore-hsqldb-schema.sql lines 52-59              -->
        <!-- Stores user preferences: language, favourite category, list  -->
        <!-- and banner display options                                   -->
        <!-- ============================================================ -->
        <createTable tableName="profile">
            <column name="userid" type="varchar(80)">
                <constraints primaryKey="true" primaryKeyName="pk_profile" nullable="false"/>
            </column>
            <column name="langpref" type="varchar(80)">
                <constraints nullable="false"/>
            </column>
            <column name="favcategory" type="varchar(30)"/>
            <column name="mylistopt" type="integer"/>
            <column name="banneropt" type="integer"/>
        </createTable>

        <!-- ============================================================ -->
        <!-- bannerdata table                                             -->
        <!-- Source: jpetstore-hsqldb-schema.sql lines 61-65              -->
        <!-- Maps favourite category to a banner image name for           -->
        <!-- personalized display on the main page                        -->
        <!-- ============================================================ -->
        <createTable tableName="bannerdata">
            <column name="favcategory" type="varchar(80)">
                <constraints primaryKey="true" primaryKeyName="pk_bannerdata" nullable="false"/>
            </column>
            <column name="bannername" type="varchar(255)"/>
        </createTable>

    </changeSet>

</databaseChangeLog>
