<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ===================================================================== -->
    <!-- BCrypt Migration for Existing Seed Passwords                          -->
    <!-- ===================================================================== -->
    <!-- Converts plaintext seed passwords inserted by 002-seed-data.xml into  -->
    <!-- BCrypt hashes. This ensures all passwords in the signon table use     -->
    <!-- BCrypt encoding, aligning with AAP security requirements.             -->
    <!--                                                                       -->
    <!-- BCrypt hashes are 60 characters ($2b$10$...) and the column was       -->
    <!-- widened to varchar(72) by 003-widen-signon-password.xml.              -->
    <!--                                                                       -->
    <!-- Pre-generated hashes (BCrypt cost factor 10):                         -->
    <!--   j2ee -> $2b$10$BJsUpwsbfiR7bfSmM1c83Ob9O1jtrXGL2fwivDnmzstnQdY8ZvOpK -->
    <!--   ACID -> $2b$10$3cMBktPSCuAhOyh37jLra.5/0L4SIqEidomGgFUSa.nvPOT5cC5Ea -->
    <!-- ===================================================================== -->

    <changeSet id="004-hash-seed-passwords" author="jpetstore-security">
        <comment>Convert plaintext seed passwords to BCrypt hashes for security compliance</comment>

        <!-- Update j2ee user password to BCrypt hash -->
        <update tableName="signon">
            <column name="password" value="$2b$10$BJsUpwsbfiR7bfSmM1c83Ob9O1jtrXGL2fwivDnmzstnQdY8ZvOpK"/>
            <where>username = 'j2ee' AND LENGTH(password) &lt; 50</where>
        </update>

        <!-- Update ACID user password to BCrypt hash -->
        <update tableName="signon">
            <column name="password" value="$2b$10$3cMBktPSCuAhOyh37jLra.5/0L4SIqEidomGgFUSa.nvPOT5cC5Ea"/>
            <where>username = 'ACID' AND LENGTH(password) &lt; 50</where>
        </update>
    </changeSet>

</databaseChangeLog>
