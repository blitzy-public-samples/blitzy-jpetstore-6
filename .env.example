# =============================================================================
# JPetStore Microservices — Environment Variables
# =============================================================================
# Copy this file to .env and customize the values for your environment.
# Docker Compose automatically reads .env files from the project root.
#
# All variables below have safe development defaults in docker-compose.yml.
# For production deployments, override these with strong, unique values.
# =============================================================================

# -----------------------------------------------------------------------------
# Account Service PostgreSQL Database
# -----------------------------------------------------------------------------
ACCOUNT_DB_NAME=jpetstore_account
ACCOUNT_DB_USER=account_user
ACCOUNT_DB_PASSWORD=account_pass

# -----------------------------------------------------------------------------
# Catalog Service PostgreSQL Database
# -----------------------------------------------------------------------------
CATALOG_DB_NAME=jpetstore_catalog
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=catalog_pass

# -----------------------------------------------------------------------------
# Order Service PostgreSQL Database
# -----------------------------------------------------------------------------
ORDER_DB_NAME=jpetstore_order
ORDER_DB_USER=order_user
ORDER_DB_PASSWORD=order_pass

# -----------------------------------------------------------------------------
# JWT Authentication Secret
# -----------------------------------------------------------------------------
# IMPORTANT: Change this value for production deployments. The default is a
# development-only placeholder. Use a strong, random secret (minimum 256 bits).
JWT_SECRET=jpetstore-jwt-secret-key-for-development-only-change-in-production
